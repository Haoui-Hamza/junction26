# --- Server ---
PORT=3000
# SQLite file for orders, approvals, history and the local provider's offers. Use :memory: for throwaway runs.
DB_PATH=./order-guard.db

# --- Provider selection: "local" (seeded, deterministic, default) or "valio" (Valio Aimo mock API) ---
PROVIDER=local
# Fixed clock for the seeded demo (Friday 13 Nov 2026, 09:00 Helsinki). Leave empty to use the system clock.
# Default when PROVIDER=local: 2026-11-13T09:00:00+02:00
FIXED_CLOCK=
# Enables /api/v1/demo/* controls (reset fixtures, change price, inject faults). Default: true for local, false for valio.
DEMO_MODE=

# --- Valio Aimo mock API (only for PROVIDER=valio). Key comes from the Junction platform. Never commit it. ---
AIMO_API_BASE=https://junction26.valioaimo.fi/api
AIMO_API_KEY=
AIMO_PRODUCT_DATA=./data/valio_aimo_junction26_product_data.json
# With PROVIDER=valio, save demo orders locally after live quote revalidation. No order is sent to Valio.
SIMULATE_VALIO_ORDERS=true

# --- OpenAI agent (natural language intake + MCP tool use). Without a key, use the structured form fallback. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Seeded actor tokens (demo identities, not provider credentials). Override outside local demos. ---
AGENT_TOKEN=demo-agent-token
BUYER_TOKEN=demo-buyer-token
APPROVER_TOKEN=demo-approver-token

# --- MCP adapter (npm run mcp) ---
ORDER_GUARD_URL=http://localhost:3000

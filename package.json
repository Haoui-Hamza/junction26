{
  "name": "aimo-order-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aimo Order Guard - trusted purchasing agent prototype (Junction 2026, Valio Aimo)",
  "scripts": {
    "start": "vite build && tsx server/src/main.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/src/main.ts\" \"vite\"",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.10.0",
    "express": "^5.3.0",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
